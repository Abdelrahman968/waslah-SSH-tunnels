{
  "name": "waslah",
  "productName": "Waslah",
  "version": "1.0.0",
  "description": "SSH-based VPN tunnel client with SNI bypass support - Windows",
  "main": "main/main.js",
  "author": {
    "name": "Abdelrahman Ayman",
    "url": "https://abdelrahman-portfolio-rho.vercel.app"
  },
  "homepage": "https://abdelrahman-portfolio-rho.vercel.app",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "build": "electron-builder --win",
    "build:x64": "electron-builder --win --x64",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "jimp": "^0.22.12",
    "qrcode-reader": "^1.0.4",
    "socksv5": "^0.0.6",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.abdelrahman968.waslah",
    "productName": "Waslah",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "asar": true,
    "compression": "maximum",
    "copyright": "© 2026 Abdelrahman Ayman",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.log",
      "!**/.git/**",
      "!**/.github/**",
      "!node_modules/**/{test,__tests__,tests,example,examples}",
      "!node_modules/**/{README.md,README,readme.md,CHANGELOG.md}"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "publisherName": "Abdelrahman Ayman",
      "legalTrademarks": "Waslah",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Waslah",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}